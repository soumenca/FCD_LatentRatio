{
  "experiment_name": "exp_b_cril_unet",
  "data_root": "data",
  "split_file": "data/splits/shared_5fold_split.json",
  "dataset_format": "nnunetv2",
  "include_controls": true,
  "t1_channel_index": 0,
  "flair_channel_index": 1,
  "seed": 42,
  "num_folds": 5,
  "val_ratio": 0.15,
  "batch_size": 4,
  "num_workers": 4,
  "epochs": 500,
  "learning_rate": 0.0001,
  "weight_decay": 0.00001,
  "use_amp": true,
  "cache_subject_arrays": true,
  "loss": {
    "name": "dice_bce",
    "bce_weight": 0.5
  },
  "positive_patch_prob": 0.7,
  "patch_size": [96, 96, 96],
  "model": {
    "name": "cril_unet",
    "in_channels": 2,
    "out_channels": 1,
    "encoder_channels": [32, 64, 128, 256, 512],
    "cril_hidden_channels": 16,
    "cril_latent_channels": 4
  },
  "input_mode": "t1_flair"
}
